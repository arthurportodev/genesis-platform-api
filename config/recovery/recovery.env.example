# Non-secret recovery configuration. Copy to /opt/genesis/recovery/recovery.env
# only during an approved production window.
RECOVERY_CONTRACT=/opt/genesis/release/config/recovery/backup-restore.v1.json
RECOVERY_RELEASE_DIR=/opt/genesis/release
RECOVERY_BIN_DIR=/opt/genesis/recovery/bin
RECOVERY_STAGING_DIR=/var/lib/genesis/recovery/staging
RECOVERY_STATUS_DIR=/var/lib/genesis/recovery/status
RECOVERY_AGE_RECIPIENT_FILE=/opt/genesis/recovery/age-recipient.txt
RECOVERY_AGE_IDENTITY_FILE=/opt/genesis/secrets/recovery-age-identity
RECOVERY_RCLONE_CONFIG=/opt/genesis/secrets/recovery-rclone.conf
RECOVERY_RCLONE_REMOTE=genesis-drive
RECOVERY_REMOTE_ROOT=genesis-recovery
RECOVERY_BACKUP_PGPASS_FILE=/opt/genesis/secrets/recovery-backup-pgpass
RECOVERY_BOOTSTRAP_PGPASS_FILE=/opt/genesis/secrets/postgres-bootstrap-pgpass
RECOVERY_BACKUP_ROLE_PROVENANCE_FILE=/var/lib/genesis/recovery/status/backup-role-provenance.v1.json
RECOVERY_BACKUP_DATABASE_USER=genesis_backup
RECOVERY_DATABASE_HOST=postgres
RECOVERY_DATABASE_PORT=5432
RECOVERY_DATABASE_NAME=genesis_platform
RECOVERY_PRODUCTION_NETWORK=genesis_database
RECOVERY_BACKUP_LOCK=/run/lock/genesis-backup.lock
RECOVERY_RESTORE_LOCK=/run/lock/genesis-restore.lock
RECOVERY_RESTORE_SECRETS_DIR=/opt/genesis/secrets/recovery-synthetic
RECOVERY_CONTAINER_SECRET_GID=70
