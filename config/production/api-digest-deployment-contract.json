{
  "schemaVersion": "1.0.0",
  "contractId": "0.8-MVP-09E.api-digest-deployment.v1",
  "root": {
    "path": "/opt/genesis/release",
    "owner": 0,
    "group": 0,
    "mode": "0755"
  },
  "state": {
    "relativePath": "deployment-state",
    "owner": 0,
    "group": 0,
    "mode": "0755",
    "stagingPrefix": ".staging-",
    "stagingMode": "0700"
  },
  "overlays": {
    "relativePath": "deployment-state/overlays",
    "owner": 0,
    "group": 0,
    "directoryMode": "0755",
    "fileName": "compose.api-image.json",
    "fileMode": "0644",
    "format": "compose-json-v1",
    "requiredShape": {
      "services": {
        "api": {
          "image": "immutable-digest-reference"
        }
      }
    }
  },
  "pointers": {
    "relativePath": "deployment-state/pointers.json",
    "owner": 0,
    "group": 0,
    "temporaryPrefix": ".pointers.",
    "schemaVersion": "1.0.0",
    "fields": ["current", "previous"],
    "atomicUpdate": "write-fsync-replace-fsync-directory",
    "interruptionRecovery": "validate-document-remove-temporaries-recover-live-target-to-current-baseline",
    "fileMode": "0644"
  },
  "evidence": {
    "relativePath": "deployment-state/evidence",
    "owner": 0,
    "group": 0,
    "directoryMode": "0700",
    "snapshotMode": "0600",
    "hashMode": "0600",
    "content": "utc-timestamp-and-classification-only",
    "rawLogRetention": "memory-or-root-temporary-until-sanitized-then-delete"
  },
  "images": {
    "target": "ghcr.io/arthurportodev/genesis-platform-api@sha256:b45425d7f6ea63bde18e53195dab0ef0af43a84c55402a1ecc70321484e05feb",
    "rollback": "ghcr.io/arthurportodev/genesis-platform-api@sha256:a4dafefab191093ea7547e47ed09783cff2abb67b177cabd09aa07b94ac5797a"
  },
  "service": "api",
  "policy": {
    "allowMutableTags": false,
    "allowCredentials": false,
    "allowSymlinks": false,
    "allowExternalPaths": false,
    "allowedOverlayKeys": ["services", "api", "image"],
    "forbiddenServices": ["postgres", "migrate", "traefik"],
    "forbiddenFieldPatterns": [
      "auth",
      "credential",
      "password",
      "secret",
      "token"
    ]
  },
  "retention": {
    "minimumValidatedBundles": 2,
    "preserveCurrent": true,
    "preservePrevious": true,
    "cleanupPolicy": "remove-only-unreferenced-validated-bundles-after-observation",
    "automaticDeletion": false
  },
  "observation": {
    "checkpointsMinutes": [0, 2, 5, 10, 15],
    "requiredSmokes": [
      "immutable-runtime-digest",
      "running-healthy-zero-restarts",
      "ready-with-database",
      "public-health-200",
      "missing-route-404",
      "invalid-method-404",
      "csrf-valid-synthetic-invalid-auth-401",
      "dependency-identities-unchanged",
      "cumulative-sanitized-log-evaluation",
      "latency-threshold",
      "resource-threshold"
    ],
    "logWindow": "closed-cumulative-deployment-start-to-checkpoint",
    "logClassification": "portable-case-insensitive",
    "metricValidation": "finite-nonnegative-decimal-fail-closed",
    "thresholds": {
      "fatalCount": 0,
      "databaseErrorCount": 0,
      "consecutiveHttp5xxCheckpoints": 2,
      "healthLatencySeconds": 2,
      "consecutiveLatencyBreaches": 2,
      "cpuPercent": 90,
      "memoryPercent": 85,
      "consecutiveResourceBreaches": 2
    },
    "failureAction": "rollback-and-block-keep"
  },
  "rollback": {
    "source": "pre-deployment-current-pointer",
    "validateBeforeActivation": true,
    "activatePointerAfterHealth": true,
    "pullPolicy": "never",
    "interruptedState": "live-target-current-baseline-previous-validated",
    "interruptedAction": "rollback-baseline-before-new-attempt"
  }
}
