# Somente configuracao nao secreta. Secrets de producao sao arquivos separados
# em /opt/genesis/secrets e nunca pertencem a um arquivo .env.
DATABASE_NAME=genesis_platform
DATABASE_BOOTSTRAP_USER=genesis_bootstrap
DATABASE_MIGRATION_USER=genesis_migration
DATABASE_RUNTIME_ROLE=genesis_runtime

APP_NAME=Genesis Platform API
APP_VERSION=0.1.0
# Obrigatorio e nao secreto. Substitua pelo email operacional aprovado antes
# de qualquer ACME; o dominio invalid mantem validacoes locais fail-closed.
ACME_EMAIL=acme-contact-required@genesis.invalid
TRUST_PROXY_HOPS=1
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# A origem fail-closed https://genesis.invalid e fixada no Compose ate a MVP-08.
# O keyring e secret file-backed; somente sua versao corrente e nao secreta.
LEAD_IDEMPOTENCY_KEY_CURRENT_VERSION=1

# Limites provisórios aprovados para a VPS atual.
API_CPUS=0.75
API_MEMORY_LIMIT=1g
API_PIDS_LIMIT=128
API_NODE_MAX_OLD_SPACE_MB=640
MIGRATE_CPUS=0.75
MIGRATE_MEMORY_LIMIT=1g
MIGRATE_PIDS_LIMIT=128
MIGRATE_NODE_MAX_OLD_SPACE_MB=640
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_PIDS_LIMIT=256
TRAEFIK_CPUS=0.50
TRAEFIK_MEMORY_LIMIT=256m
TRAEFIK_PIDS_LIMIT=128
