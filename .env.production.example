# Imagem local ou remota identificável. A publicação no GHCR pertence à 0.8-MVP-04.
GENESIS_API_IMAGE=genesis-platform-api:replace-with-candidate-tag

DATABASE_NAME=genesis_platform
DATABASE_MIGRATION_USER=genesis_owner
DATABASE_MIGRATION_PASSWORD=
DATABASE_RUNTIME_ROLE=genesis_runtime
DATABASE_RUNTIME_PASSWORD=

APP_NAME=Genesis Platform API
APP_VERSION=0.1.0
FRONTEND_URL=https://app.example.com
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_PEPPER=

# Limites provisórios; confirmar contra o inventário da VPS na 0.8-MVP-05.
API_CPUS=0.75
API_MEMORY_LIMIT=1g
API_PIDS_LIMIT=128
API_NODE_MAX_OLD_SPACE_MB=640
MIGRATE_CPUS=0.75
MIGRATE_MEMORY_LIMIT=1g
MIGRATE_PIDS_LIMIT=128
MIGRATE_NODE_MAX_OLD_SPACE_MB=640
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_PIDS_LIMIT=256
